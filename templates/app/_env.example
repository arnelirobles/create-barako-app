# Copy to .env and fill in. `create-barako-app` writes a .env with real generated values already,
# so this file is here for the next person who clones the repository.

# Postgres password for the compose stack.
DB_PASSWORD=

# 32 characters minimum or the API refuses to start.
JWT_KEY=

# Created on the API's first boot, when the user table is empty. Changing these later does nothing
# to an existing database: use the console to change a password.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

API_PORT=5005
CONSOLE_PORT=3001
WEB_PORT=3000

# Where the browser reaches the API.
NEXT_PUBLIC_CMS_URL=http://localhost:5005

# Where the Next server reaches it. The same address, because `npm run dev` runs this app on your
# machine and not inside the compose network. Move the site into compose as a service of its own
# and this becomes http://api:8080, the service name, which only resolves in there.
CMS_URL=http://localhost:5005
