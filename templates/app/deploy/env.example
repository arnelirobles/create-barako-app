# Copy this to `.env` in this directory ON THE VM, fill it in, and keep it there. It is not synced
# by a deploy, so a release cannot overwrite it, and it is not in the repository.

# Postgres password. Generate one, do not reuse the development value.
DB_PASSWORD=

# 32 characters minimum or the API refuses to start.
JWT_KEY=

# Created on the API's first boot only, when the user table is empty.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Where a browser reaches each piece, through your reverse proxy. Used for CORS and by the console.
PUBLIC_ORIGIN=https://example.com
API_ORIGIN=https://api.example.com
CONSOLE_ORIGIN=https://admin.example.com

# Loopback ports on the VM for the proxy to point at. Nothing is bound to 0.0.0.0.
API_PORT={{API_PORT}}
CONSOLE_PORT={{CONSOLE_PORT}}
WEB_PORT={{WEB_PORT}}
